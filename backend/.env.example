# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. docker-compose sets this for you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# Signs every session token. MUST be a random secret in any deployment —
# with ENVIRONMENT set to anything other than development/local/test, the
# app refuses to start while this is still the built-in default.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-change-me

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# development | production. Anything that isn't development/dev/local/test
# is treated as a real deployment and enforces the checks above.
ENVIRONMENT=development

# Browser origins allowed to call the API. Comma-separated, or a JSON array.
CORS_ORIGINS=http://localhost:3050,http://localhost:3000

# Accounts allowed to read /admin/*, which sees across every tenant.
# Comma-separated emails. Empty means nobody has admin access.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------

# Set CHROMA_HOST to talk to a Chroma server (docker-compose runs one).
# Leave it empty to use an on-disk store at CHROMA_PATH instead, so a bare
# `uvicorn` run needs no extra services.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PATH=./chroma_db

# Where the embedding model is cached. Defaults to ~/.cache/fastembed.
FASTEMBED_CACHE_DIR=

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# openrouter | ollama
LLM_PROVIDER=openrouter

# OpenRouter (or any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

DOCUMENT_STORAGE_DIR=./uploads
